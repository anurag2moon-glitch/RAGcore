# Prod profile starter - this deployment task's scope is staging, not
# a hardened prod rollout (no Kubernetes/autoscaling yet - a future
# ADR), but the setting *shape* for prod differs enough from staging
# to warrant its own file rather than letting someone copy
# .env.staging.example and miss these.

ENVIRONMENT=prod
LOG_LEVEL=WARNING

# Every secret below should come from a mounted secrets file instead
# of this file in a real prod deployment - see server/.env.example's
# own "mounted secrets file" section and app/settings.py's docstring.
# Leave the matching env var unset here and provision
# /run/secrets/<name> (lowercase field name) via your orchestrator's
# secret store instead.
# DATABASE_URL=
# REDIS_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# RAGCORE_API_KEYS=
# VOYAGE_API_KEY=
# ANTHROPIC_API_KEY=

# Multi-tenant auth is expected to be on in prod, not optional as in
# dev/staging - RAGCORE_API_KEYS (or PostgresApiKeyStore via
# DATABASE_URL) must be set, or every route stays unauthenticated.
RAGCORE_RATE_LIMIT_PER_MINUTE=60
