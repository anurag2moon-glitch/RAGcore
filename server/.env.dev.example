# Local dev profile - copy to .env (or `cp server/.env.dev.example server/.env`).
# Single-tenant, synchronous-everything, nothing external required
# beyond VOYAGE_API_KEY/ANTHROPIC_API_KEY (see server/.env.example for
# every variable's own documentation - this file only sets the ones
# that differ meaningfully from the defaults for this profile).

ENVIRONMENT=dev
LOG_LEVEL=DEBUG

RAGCORE_DB_PATH=./data/corpus.lancedb

# Unset: no DATABASE_URL/REDIS_URL/S3_* - /ingest runs unavailable
# (503) unless you also run Postgres/Redis/MinIO locally; every other
# route works against a single local Corpus with no auth, no queue.
# Uncomment to exercise the full async stack without Compose:
# DATABASE_URL=postgresql://ragcore:ragcore@localhost:5432/ragcore
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY_ID=ragcore
# S3_SECRET_ACCESS_KEY=ragcore-dev-secret

VOYAGE_API_KEY=
ANTHROPIC_API_KEY=
