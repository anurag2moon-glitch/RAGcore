# Staging profile - matches docker-compose.yml's own expectations.
# Copy to server/.env before `make up` (the compose file's own
# x-app-env anchor overrides DATABASE_URL/REDIS_URL/S3_ENDPOINT_URL/
# S3_BUCKET/OTEL_EXPORTER_OTLP_ENDPOINT to the in-network service
# names regardless of what's set here - this file only needs to carry
# the pieces Compose does *not* already hardcode: credentials, API
# keys, and anything tenant/auth-related).

ENVIRONMENT=staging
LOG_LEVEL=INFO

S3_ACCESS_KEY_ID=ragcore
S3_SECRET_ACCESS_KEY=ragcore-dev-secret

# Unset = single-tenant, unauthenticated. Set this to require
# X-API-Key on every route (see server/README.md's "Multi-tenant
# mode" section) - scripts/seed_staging.py provisions a matching
# Postgres row once the stack is up (`make seed`).
# RAGCORE_API_KEYS=

VOYAGE_API_KEY=
ANTHROPIC_API_KEY=
