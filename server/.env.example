# Copy to .env and fill in. Every variable here is read by
# app.settings.Settings (server/app/settings.py) — see that module's
# own docstring, and docs/DEPLOYMENT.md for the full reference.
# Never commit a real .env file (it's gitignored) and never bake
# secrets into a Docker image — pass them via this file (dev) or a
# mounted secrets file / your orchestrator's secret store (staging/prod).
#
# Mounted secrets file, as an alternative to any variable below: put a
# file named after the setting, lowercase (e.g. `database_url`,
# `s3_secret_access_key`) under RAGCORE_SECRETS_DIR (default
# /run/secrets — Docker/Compose's own secrets convention) and leave
# the matching env var unset. A real env var always wins when both are
# present — see app/settings.py's own docstring for how this is wired
# (pydantic-settings' secrets_dir).
# RAGCORE_SECRETS_DIR=/run/secrets

# -- environment ---------------------------------------------------------

# dev | staging | prod
ENVIRONMENT=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# -- ragcore storage (unchanged from before this settings model existed) --

# On-disk LanceDB path the api/worker containers open via Corpus.open().
# In Compose this is a path inside the shared lancedb_data volume.
RAGCORE_DB_PATH=./data/corpus.lancedb

# On-disk SQLite path for the Phase 10 rule base (optional — only needed
# if you're serving/extracting rules).
RAGCORE_RULES_DB_PATH=./data/rules.sqlite3

# -- auth / rate limiting / quotas (all optional, all opt-in) -------------

# "key1:tenant-a,key2:tenant-b" - unset means single-tenant, unauthenticated.
# Prefer PostgresApiKeyStore (DATABASE_URL below) for anything beyond local dev.
# RAGCORE_API_KEYS=dev-key:dev-tenant

# Requests/minute per tenant (or per client IP in single-tenant mode).
# RAGCORE_RATE_LIMIT_PER_MINUTE=60

# "tenant-a:1000,tenant-b:5000" - lifetime total request cap per tenant.
# RAGCORE_TENANT_QUOTAS=dev-tenant:10000

# "tenant-a:100000,tenant-b:500000" - lifetime total token cap for
# /rules/extract specifically, metered from real Claude API usage.
# RAGCORE_EXTRACTION_TOKEN_QUOTAS=dev-tenant:1000000

# -- postgres: tenant/API-key registry -------------------------------------

DATABASE_URL=postgresql://ragcore:ragcore@postgres:5432/ragcore

# -- redis: async ingestion job queue --------------------------------------

REDIS_URL=redis://redis:6379/0

# -- object storage: MinIO (or any S3-compatible endpoint) -----------------

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=ragcore
S3_SECRET_ACCESS_KEY=ragcore-dev-secret
S3_REGION=us-east-1
S3_BUCKET=ragcore
S3_RAW_FILES_PREFIX=raw-files/
S3_BACKUPS_PREFIX=backups/

# -- tenant data paths (never hardcoded elsewhere) -------------------------

TENANT_DATA_ROOT=./data/tenants

# -- observability ----------------------------------------------------------

# FastAPI's own built-in OpenTelemetry integration (fastapi[opentelemetry],
# server/pyproject.toml) auto-configures an OTLP http/protobuf exporter
# from this - port 4318 (http), not 4317 (grpc). Unset = spans are still
# created (FastAPI's telemetry is on by default) but never exported
# anywhere - effectively a no-op, not a crash. In Compose this points at
# the local otel-collector service (server/otel-collector-config.yaml).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=ragcore-server

# -- vendor API keys (read by the underlying SDKs, not by ragcore itself —
# see docs/CONFIGURATION.md) ------------------------------------------------

# VOYAGE_API_KEY=
# ANTHROPIC_API_KEY=
